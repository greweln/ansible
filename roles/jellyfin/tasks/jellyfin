---
- name: Copy ffmpeg
  ansible.builtin.copy:
    src: "/files/lab/packages/ffmpeg/ffmpeg"
    dest: /usr/local/bin/ffmpeg
    mode: '0755'
  
- name: Copy ffprobe
  ansible.builtin.copy:
    src: "/files/lab/packages/ffmpeg/ffprobe"
    dest: /usr/local/bin/ffprobe
    mode: '0755'

- name: Ensure systemd override directory exists
  ansible.builtin.file:
    path: /etc/systemd/system/jellyfin.service.d
    state: directory
    mode: '0755'

- name: Ensure systemd sees /usr/local/bin
  ansible.builtin.blockinfile:
    path: /etc/systemd/system/jellyfin.service.d/override.conf
    block: |
      [Service]
      Environment="PATH=/usr/local/bin:/usr/bin:/bin"
    create: yes

- name: Reload systemd
  ansible.builtin.systemd:
    daemon_reload: yes

- name: Install Jellyfin
  ansible.builtin.dnf:
    name:
      - jellyfin
      - jellyfin-server
      - jellyfin-web
    state: present
    update_cache: true

- name: Enable and start Jellyfin
  ansible.builtin.systemd:
    name: jellyfin
    enabled: true
    state: started

