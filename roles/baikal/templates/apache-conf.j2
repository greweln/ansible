<VirtualHost *:80>
    ServerName calcurse

    DocumentRoot {{ baikal_path }}/baikal/html
    DirectoryIndex index.php

    <Directory {{ baikal_path }}/baikal/html>
        AllowOverride None
        Require all granted
    </Directory>

    <IfModule mod_rewrite.c>
        RewriteEngine On
        RewriteRule ^/.well-known/caldav /dav.php/ [R=301,L]
        RewriteRule ^/.well-known/carddav /dav.php/ [R=301,L]
    </IfModule>

    <FilesMatch \.php$>
        SetHandler "proxy:unix:/run/php-fpm/www.sock|fcgi://localhost"
    </FilesMatch>

    ErrorLog /var/log/httpd/baikal_error.log
    CustomLog /var/log/httpd/baikal_access.log combined

    LimitRequestBody 20971520
</VirtualHost>
